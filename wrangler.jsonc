{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redeye",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "0,5,10,15,20,25,30,35,40,45,50,55 * * * *",
      "1,6,11,16,21,26,31,36,41,46,51,56 * * * *",
      "2,7,12,17,22,27,32,37,42,47,52,57 * * * *",
      "3,8,13,18,23,28,33,38,43,48,53,58 * * * *"
    ]
  },
  // Cron scheduled() is CPU-capped at 10ms on Free. Bind this Worker to itself
  // so the tick can POST /run as a separate HTTP invocation (own CPU budget).
  "services": [
    {
      "binding": "SELF",
      "service": "redeye"
    }
  ],
  "vars": {
    "DISCORD_USER_ID": "444017517003014144"
  },
  // Browser Run (Browser Rendering) — required for JS-heavy career pages like Meta.
  // Local: use `npm run dev` which passes --remote (quickAction needs remote mode).
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "SEEN_JOBS",
      "id": "64f99eb69c2740e9bd921419fc96c612",
      "preview_id": "64f99eb69c2740e9bd921419fc96c612"
    }
  ]
}
